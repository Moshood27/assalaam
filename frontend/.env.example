# Frontend environment variables (Vite + Vue)
#
# Copy this file to one of the following as needed:
# - .env.development   → for local web development with Vite
# - .env.production    → for production/mobile (Capacitor) builds
# - .env               → general defaults (used if mode-specific files are absent)
#
# Branding
VITE_BRAND_SLUG=assalam
VITE_APP_NAME="ASSALAM CO-OPERATIVE"
# Optional: Admin panel origin (Filament). Used for redirect after admin login.
VITE_BACKEND_ORIGIN=http://localhost:8000
# Silence noisy MetaMask-related errors in environments without extensions
VITE_SILENCE_METAMASK_ERRORS=true
#
# Development (Vite dev server proxy)
# Vite proxies /api → your backend during development. Change if your backend runs elsewhere.
VITE_PROXY_TARGET=http://localhost:8000

# Production / Mobile (Capacitor)
# Axios uses this origin as baseURL in production/mobile builds.
# Example values:
# - Localhost (web preview): http://localhost
# - Android emulator:        http://10.0.2.2
# - Real device / server:    https://api.example.com
VITE_API_URL=http://localhost

# Optional: HTTP request timeout for axios (milliseconds). Default used in code is 15000 ms.
# Increase when calling slow networks; decrease to fail fast.
VITE_HTTP_TIMEOUT=15000

# Optional: Live reload on device/emulator with Capacitor
# Replace YOUR_LAN_IP with your machine's LAN IP address so the device can reach the Vite dev server.
# Example: http://192.168.1.50:5174
VITE_MOBILE_SERVER_URL=http://YOUR_LAN_IP:5174
