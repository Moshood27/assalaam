{
  "name": "ATTAQWA",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "precap:sync": "npm run cap:assets",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "precap:assets": "node scripts/generate-branded-assets.mjs --force",
    "cap:assets": "npx @capacitor/assets generate --androidProject frontend/android --iosProject frontend/ios/App --pwaManifestPath frontend/public/manifest.webmanifest",
    "precap:assets:android": "node scripts/generate-branded-assets.mjs --force",
    "cap:assets:android": "npx @capacitor/assets generate --android --androidProject frontend/android",
    "precap:assets:ios": "node scripts/generate-branded-assets.mjs --force",
    "cap:assets:ios": "npx @capacitor/assets generate --ios --iosProject frontend/ios/App",
    "precap:assets:pwa": "node scripts/generate-branded-assets.mjs --force",
    "cap:assets:pwa": "npx @capacitor/assets generate --pwa --pwaManifestPath frontend/public/manifest.webmanifest",
    "assets:placeholders": "node scripts/generate-placeholder-assets.mjs",
    "assets:brand": "node scripts/generate-branded-assets.mjs --force",
    "assets:brand:assalam": "node scripts/generate-branded-assets.mjs --force --brand assalam",
    "assets:brand:attaqwa": "node scripts/generate-branded-assets.mjs --force --brand attaqwa",
    "mobile:assets:sync": "npm run cap:assets && npm run cap:sync",
    "mobile:assets:sync:assalam": "node scripts/generate-branded-assets.mjs --force --brand assalam && npm run cap:assets && npm run cap:sync",
    "mobile:assets:android": "npm run cap:assets:android && npx cap sync android",
    "mobile:assets:android:assalam": "node scripts/generate-branded-assets.mjs --force --brand assalam && npm run cap:assets:android && npx cap sync android",
    "mobile:assets:ios": "npm run cap:assets:ios && npx cap sync ios",
    "mobile:assets:ios:assalam": "node scripts/generate-branded-assets.mjs --force --brand assalam && npm run cap:assets:ios && npx cap sync ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@capacitor/android": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/assets": "^3.0.0",
    "typescript": "^5.9.3"
  }
}
