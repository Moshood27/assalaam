APP_NAME=ATTAQWA
APP_ENV=local
# Generate a new key in your environment with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# APP_PORT is configured in the Docker Compose section below

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=coop_attaqwa
DB_USERNAME=sail_attaqwa
DB_PASSWORD=pass_attaqwa

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Old data import (members, loans, investment_record_details)
# Enable this to import and transform data from database/old_databse.sql during seeding
SEED_OLD_DATA=false

# Paystack configuration
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxx
# Optional: Keep this in sync with your Paystack Dashboard webhook setting
# For local testing with ngrok, set this to your ngrok public URL + /api/webhooks/paystack
# Example: https://<random-or-reserved>.ngrok-free.app/api/webhooks/paystack
PAYSTACK_WEBHOOK_URL="${APP_URL}/api/webhooks/paystack"

# Flutterwave configuration
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxxx
# Secret Hash used to verify webhooks (set in Flutterwave Dashboard -> Webhooks)
FLW_SECRET_HASH=your-webhook-secret-hash
# Optional: Keep this in sync with your Flutterwave Dashboard webhook setting
# For local testing with ngrok, set this to your ngrok public URL + /api/webhooks/flutterwave
# Example: https://<random-or-reserved>.ngrok-free.app/api/webhooks/flutterwave
FLW_WEBHOOK_URL="${APP_URL}/api/webhooks/flutterwave"

# Ngrok (optional, for local webhook testing)
# Sign up at https://ngrok.com, get your auth token, and set it here to enable the ngrok service in docker-compose
NGROK_AUTHTOKEN=
# Inspector UI port for ngrok (http://localhost:4040)
FORWARD_NGROK_INSPECT_PORT=4040

# VTU provider (VTpass) configuration
# Leave VTU_BASE_URL empty to auto-select sandbox in local or when VTU_SANDBOX=true
# Set VTU_SANDBOX=false and/or provide VTU_BASE_URL to use live endpoint
VTU_PROVIDER=vtpass
VTU_SANDBOX=true
VTU_BASE_URL=
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
# Revenue controls
VTU_DEFAULT_DISCOUNT=0.03
VTU_CONVENIENCE_FEE=0
# Optional: Set your public webhook URL for VTU callbacks (e.g., Sail Share / Ngrok URL)
# Example: https://<your-public-host>/api/vtu/webhook
VTU_WEBHOOK_URL="${APP_URL}/api/vtu/webhook"

# SMS notifications
# Master switch to enable/disable SMS sending
SMS_ENABLED=false
# Driver: termii | log | generic
SMS_DRIVER=log
# Default sender name (11 chars max on some networks)
SMS_SENDER=Coop
# Termii credentials (if using SMS_DRIVER=termii)
SMS_API_KEY=
SMS_BASE_URL=https://api.ng.termii.com
SMS_CHANNEL=generic
# Generic JSON provider endpoint (if using SMS_DRIVER=generic)
SMS_URL=

# --- Docker Compose (Sail) ports and forwards ---
# Host port to expose Laravel (container port 80)
APP_PORT=8080
# Host port for the Vite dev server container
FRONTEND_PORT=5174
# Optional: expose the Laravel container's internal Vite port (not used if you run separate frontend container)
VITE_PORT=5173
# Optional: forward MySQL container port to host (leave default if not needed)
FORWARD_DB_PORT=33060
# Mailpit ports
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# CORS configuration
# Comma-separated list of allowed origins for cross-origin requests. Do NOT use '*'.
# Example: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# If you rely on cookies (not typical for this app which uses Bearer tokens), set to true.
CORS_SUPPORTS_CREDENTIALS=false

# API inactivity timeout (Sanctum PAT) in seconds; token is revoked after this idle period
INACTIVITY_TIMEOUT_SECONDS=120

# Appropriation ratios for Appropriation Account (JSON)
# List of objects with name and percent keys. The percentages are applied to the surplus; the remainder is carried forward.
# Example: [{"name":"Statutory Reserve","percent":25},{"name":"General Reserve","percent":10}]
APPROPRIATION_RATIOS='[{"name":"Statutory Reserve","percent":25},{"name":"General Reserve","percent":10}]'
