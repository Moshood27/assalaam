# Paystack configuration
# Mode: test or live (defaults to 'live' when APP_ENV=production, else 'test')
PAYSTACK_ENV=test
# Live keys (from your Paystack live account)
PAYSTACK_LIVE_PUBLIC_KEY=
PAYSTACK_LIVE_SECRET_KEY=
# Test keys (from your Paystack test account)
PAYSTACK_TEST_PUBLIC_KEY=pk_test_4d1ffe456b53fb7f1118136a428d27970028d083
PAYSTACK_TEST_SECRET_KEY=sk_test_98c8350f40ff728f68b0bf3ca67cfb1ff1f38eea
# Backward compatibility: if the above are not set, these will be used
PAYSTACK_PUBLIC_KEY=pk_test_4d1ffe456b53fb7f1118136a428d27970028d083
PAYSTACK_SECRET_KEY=sk_test_98c8350f40ff728f68b0bf3ca67cfb1ff1f38eea
# Optional: Keep this in sync with your Paystack Dashboard webhook setting
PAYSTACK_WEBHOOK_URL=https://islamcoop.com/api/webhooks/paystack

# Ngrok (optional, for local webhook testing)
# Sign up at https://ngrok.com, get your auth token, and set it here to enable the ngrok service in docker-compose
NGROK_AUTHTOKEN=1uAumGbJMSj6RpEjGWwnFdSJD6Q_31nbTYcweqR1Xfx5WNbht
# Inspector UI port for ngrok (http://localhost:4040)
FORWARD_NGROK_INSPECT_PORT=4040


# Old data import (members, loans, investment_record_details)
# Enable this to import and transform data from database/old_databse.sql during seeding
SEED_OLD_DATA=true


# Host port for the Vite dev server container
FRONTEND_PORT=5174
# Optional: expose the Laravel container's internal Vite port (not used if you run separate frontend container)
VITE_PORT=5173
# Optional: forward MySQL container port to host (leave default if not needed)
FORWARD_DB_PORT=33060
# Mailpit ports
#FORWARD_MAILPIT_PORT=1025
#FORWARD_MAILPIT_DASHBOARD_PORT=8025
PHP_VERSION=8.4

# Takaful (Mutual Protection Pool)
# Monthly non-refundable contribution in NGN (default: 200)
TAKAFUL_MONTHLY_AMOUNT=200

# Wallet Maintenance Charge
# Percentage of the top-up amount (e.g., 1 for 1%)
COOP_WALLET_MAINTENANCE_CHARGE_PERCENTAGE=1
# Maximum charge amount in NGN
COOP_WALLET_MAINTENANCE_CHARGE_MAX=500

# Mobile App forced update and maintenance mode
MOBILE_MIN_VERSION=1.0.0
MOBILE_CURRENT_VERSION=1.0.0
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="We are currently performing scheduled maintenance to improve our services. We'll be back shortly."
MAINTENANCE_UNTIL="Approximately 1 hour"
SYSTEM_ANNOUNCEMENT=null
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.attaqwa.app

# Zakat & Nisab API Integration
GOLDAPI_KEY=goldapi-jtwy19mo1p67ch-io
GOLDAPI_CURRENCY=USD
USD_NGN_RATE=auto
ZAKAT_NISAB_GOLD_GRAMS=85
ZAKAT_NISAB_SILVER_GRAMS=595
ZAKAT_FITR_AMOUNT=3500
ZAKAT_RATE=0.025
ZAKAT_LUNAR_DAYS=354


# VTU provider configuration
# Primary provider is VTpass; you can add others for Smart Routing (see VTU_ROUTING_ORDER below)
VTU_PROVIDER=vtpass
# Force sandbox (uses https://sandbox.vtpass.com/api). In production, set to false.
VTU_SANDBOX=true
# Override base URL if needed (otherwise auto-selects based on VTU_SANDBOX)
VTU_BASE_URL=
# VTpass credentials (from VTpass dashboard)
VTPASS_API_KEY=83edd9aaa48ac2155ffb4fc307003220
VTPASS_PUBLIC_KEY=PK_4862321d733e220709bb24fba02607f912d952a6fb6
VTPASS_SECRET_KEY=SK_457a79f9adab2446d2df85f4310656ae148dcb7916d
# Smart routing: order of providers to try for VTU purchases.
# Options include: clubkonnect, shago, vtpass. Leave as-is if you only use VTpass.
VTU_ROUTING_ORDER=clubkonnect,shago,vtpass
# Low-balance alert threshold (Naira). Admins get push/SMS when any provider wallet drops below this.
VTU_LOW_BALANCE_THRESHOLD=10000
# Revenue controls
VTU_DEFAULT_DISCOUNT=0.03
VTU_CONVENIENCE_FEE=0
# Per-request webhook override sent to provider (defaults to APP_URL + /api/vtu/webhook)
VTU_WEBHOOK_URL="https://islamcoop.com/api/vtu/webhook"
# Optional additional providers for Smart Routing
# ClubKonnect (Nellobytes)
# Base URL default: https://www.nellobytesystems.com
# Required: CLUBKONNECT_USER_ID and CLUBKONNECT_API_KEY
CLUBKONNECT_ENABLED=false
CLUBKONNECT_BASE_URL=https://www.nellobytesystems.com
CLUBKONNECT_USER_ID=
CLUBKONNECT_API_KEY=
# Backward-compat/optional
CLUBKONNECT_USERNAME=
CLUBKONNECT_PASSWORD=
# Shago
SHAGO_ENABLED=false
SHAGO_BASE_URL=
SHAGO_API_KEY=
SHAGO_SECRET=

# Appropriation ratios for Appropriation Account (JSON)
# List of objects with name and percent keys. The percentages are applied to the surplus; the remainder is carried forward.
# Example: [{"name":"Statutory Reserve","percent":25},{"name":"General Reserve","percent":10}]
APPROPRIATION_RATIOS='[{"name":"Statutory Reserve","percent":25},{"name":"General Reserve","percent":10}]'



# CORS configuration
# Comma-separated list of allowed origins for cross-origin requests. Do NOT use '*'.
# Example: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=https://islamcoop.com,https://www.islamcoop.com,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,capacitor://localhost,ionic://localhost,app://localhost
# If you rely on cookies (not typical for this app which uses Bearer tokens), set to true.
CORS_SUPPORTS_CREDENTIALS=true

INACTIVITY_TIMEOUT_SECONDS=300
VITE_HTTP_TIMEOUT=15000




# SMS notifications
# Master switch to enable/disable SMS sending
SMS_ENABLED=false
# Driver: termii | log | generic
SMS_DRIVER=log
# Default sender name (11 chars max on some networks)
SMS_SENDER=Coop
# Termii credentials (if using SMS_DRIVER=termii)
SMS_API_KEY=
SMS_BASE_URL=https://api.ng.termii.com
SMS_CHANNEL=generic
# Generic JSON provider endpoint (if using SMS_DRIVER=generic)
SMS_URL=

# Google Maps configuration
GOOGLE_MAPS_API_KEY=


# Push notifications
# Enable push notifications via Firebase Cloud Messaging (FCM) or log driver for local dev.
PUSH_ENABLED=true
# Driver: fcm | log
PUSH_DRIVER=fcm_v1
# Optional: customize logging channel for log driver (leave empty to use default)
PUSH_LOG_CHANNEL=
# FCM legacy HTTP Server Key (from Firebase console). Required if PUSH_DRIVER=fcm.
FCM_SERVER_KEY=
# Base URL for FCM (rarely changed)
FCM_BASE_URL=https://fcm.googleapis.com
FIREBASE_CREDENTIALS=storage/app/firebase_credentials.json
FCM_PROJECT_ID=assalamcoop-e0dbe

#
# Real-time broadcasting (Laravel Reverb)
# Keep default as 'log' for local/dev without Reverb. Set to 'reverb' when Reverb is configured.
# Reverb server/app credentials (generate with: php artisan reverb:install)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the Reverb server runs (host/port). If using HTTPS / reverse proxy, set SCHEME=https and appropriate port (often 443)
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Optional limits
REVERB_MAX_CONNECTIONS=1000
REVERB_MAX_REQUEST_SIZE=10240
REVERB_MAX_MESSAGE_SIZE=10240
# Comma-separated allowed origins for WebSocket upgrades when behind a proxy (optional)
REVERB_ALLOWED_ORIGINS=

# KYC provider settings
# Available providers: mock, dojah
KYC_PROVIDER=mock
# Minimum confidence score to accept face match (0..1)
KYC_FACE_MATCH_MIN=0.82
# Dojah credentials (if KYC_PROVIDER=dojah)
DOJAH_APP_ID=
DOJAH_SECRET=
DOJAH_BASE_URL=https://api.dojah.io
